{
  "name": "ojapaddi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo -F native dev",
    "dev:all": "turbo dev",
    "dev:native": "turbo -F native dev",
    "dev:server": "pnpm --filter @ojapaddi/server dev",
    "wrangler": "pnpm --filter @ojapaddi/server wrangler",
    "deploy": "pnpm --filter @ojapaddi/server deploy",
    "secrets:deploy": "pnpm --filter @ojapaddi/server secrets:deploy",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "db:push": "turbo -F @ojapaddi/db db:push",
    "db:studio": "turbo -F @ojapaddi/db db:studio",
    "db:generate": "turbo -F @ojapaddi/db db:generate",
    "db:migrate": "turbo -F @ojapaddi/db db:migrate"
  },
  "dependencies": {
    "@ojapaddi/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ojapaddi/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.8.12",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "expo": "^55.0.26",
      "@expo/metro-runtime": "~55.0.11",
      "@expo/vector-icons": "^15.1.1",
      "expo-constants": "~55.0.16",
      "expo-font": "~55.0.8",
      "expo-linking": "~55.0.15",
      "@expo/log-box": "~55.0.12",
      "@expo/dom-webview": "~55.0.6",
      "rolldown": "1.0.0-beta.7"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "supabase",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
