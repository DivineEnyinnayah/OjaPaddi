{
  "name": "@ojapaddi/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "dotenv -e ../../apps/server/.env -- drizzle-kit push",
    "db:generate": "dotenv -e ../../apps/server/.env -- drizzle-kit generate",
    "db:studio": "dotenv -e ../../apps/server/.env -- drizzle-kit studio",
    "db:migrate": "dotenv -e ../../apps/server/.env -- drizzle-kit migrate"
  },
  "dependencies": {
    "@ojapaddi/env": "workspace:*",
    "@libsql/client": "^0.15.15",
    "drizzle-orm": "^0.45.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ojapaddi/config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "catalog:"
  }
}