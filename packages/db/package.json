{
  "name": "@ojapaddi/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "db:push": "bun --env-file=../../apps/server/.env drizzle-kit push",
    "db:generate": "bun --env-file=../../apps/server/.env drizzle-kit generate",
    "db:studio": "bun --env-file=../../apps/server/.env drizzle-kit studio",
    "db:migrate": "bun --env-file=../../apps/server/.env drizzle-kit migrate"
  },
  "dependencies": {
    "@ojapaddi/env": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ojapaddi/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "^6"
  }
}
