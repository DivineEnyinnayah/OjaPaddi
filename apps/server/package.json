{
  "name": "server",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "build": "bun build ./src/server.ts --outdir dist --target bun",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/server.ts --outfile server",
    "dev": "bun --env-file=.env run --hot src/server.ts",
    "dev:wrangler": "wrangler dev",
    "wrangler tail": "wrangler tail",
    "deploy": "wrangler secret bulk .dev.vars && wrangler deploy",
    "secrets:deploy": "wrangler secret bulk .dev.vars",
    "start": "bun run dist/server.js"
  },
  "dependencies": {
    "@ojapaddi/db": "workspace:*",
    "@ojapaddi/env": "workspace:*",
    "@supabase/supabase-js": "^2.105.4",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ojapaddi/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "^6",
    "wrangler": "^3.114.0"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
