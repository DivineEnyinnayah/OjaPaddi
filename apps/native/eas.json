{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
       "android":{
        "buildType":"apk"
       },
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://ojapaddi-server.enyinnayahd.workers.dev/v1",
        "EXPO_PUBLIC_DEV_MODE": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://ojapaddi-server.enyinnayahd.workers.dev/v1",
        "EXPO_PUBLIC_DEV_MODE": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
